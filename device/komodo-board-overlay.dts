// SPDX-License-Identifier: GPL-2.0-only
/*
 * Pixel 9 Pro XL (komodo MP1.0): empty overlay so that ABL finds a dtbo entry
 * with this board's board_id/board_rev. It changes nothing in the base DTB.
 *
 * Derived from Omamobile's empty Pixel 9a overlay
 * (device/tegu/tegu-m1-overlay.dts, GPL-2.0-only, by Derek Ross and
 * Omamobile contributors), with komodo's values: board_id/board_rev from the
 * stock dtbo entry id=0x60806 rev=0x10000 of build CP4A.261105.040.A1 (also in
 * Google's zumapro-komodo-mp.dts). Used by scripts/mkimages.sh.
 *
 * Overlay vacio para que ABL encuentre una entrada dtbo con el board_id y
 * board_rev de esta placa. No cambia nada del DTB base.
 */
/dts-v1/;
/plugin/;

/ {
	board_id = <0x60806>;
	board_rev = <0x10000>;

	fragment@0 {
		target-path = "/";
		__overlay__ {
		};
	};
};
