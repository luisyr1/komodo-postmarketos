# Reference: <https://postmarketos.org/devicepkg>
maintainer="komodo port <komodo@example.invalid>"
pkgname=device-google-komodo
pkgdesc="Google Pixel 9 Pro XL"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# android-tools-mkbootimg: boot-deploy runs mkbootimg (generate_bootimg)
depends="
	android-tools-mkbootimg
	linux-google-zumapro
	postmarketos-base
"
makedepends="devicepkg-dev"
subpackages="$pkgname-systemd"
source="
	deviceinfo
	kernel-cmdline.conf
	initfs-hook.sh
	60-google-komodo-ufs-ro.rules
	google-komodo-ufs-ro
	google-komodo-initfs.files
	unudhcpd.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# UFS read-only guard (rootfs and, through the .files list, initramfs)
	install -Dm644 "$srcdir"/60-google-komodo-ufs-ro.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/
	install -Dm755 "$srcdir"/google-komodo-ufs-ro \
		-t "$pkgdir"/usr/libexec/
	install -Dm644 "$srcdir"/google-komodo-initfs.files \
		"$pkgdir"/usr/share/mkinitfs/files/10-device-google-komodo.files

	# USB network addresses (initramfs and unudhcpd@usb0)
	install -Dm644 "$srcdir"/unudhcpd.conf "$pkgdir"/etc/unudhcpd.conf
}

systemd() {
	pkgdesc="$pkgdesc (systemd: login prompt on the USB serial console)"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"

	# serial-getty@ttyGS0: ttyGS0 is the ACM function the initramfs hook
	# adds to the USB gadget. BindsTo=dev-ttyGS0.device in the template.
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/getty.target.wants
	ln -s ../serial-getty@.service \
		"$subpkgdir"/usr/lib/systemd/system/getty.target.wants/serial-getty@ttyGS0.service
}

