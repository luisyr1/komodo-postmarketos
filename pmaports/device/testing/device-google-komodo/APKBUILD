# Reference: <https://postmarketos.org/devicepkg>
maintainer="komodo port <komodo@example.invalid>"
pkgname=device-google-komodo
pkgdesc="Google Pixel 9 Pro XL"
pkgver=1
pkgrel=4
url="https://postmarketos.org"
license="MIT AND Apache-2.0"
arch="aarch64"
# !pmb:crossdirect: komodo-bootctl is built with the target gcc under QEMU.
# Under crossdirect, a gcc call without -c goes to the target gcc with a
# bare argv[0]; if the host's qemu-aarch64 binfmt entry preserves argv[0]
# (flag P), that gcc finds itself in /native/usr/lib/crossdirect/<arch>
# through $PATH, relocates its search paths and fails with "cannot execute
# 'cc1'" (seen in pkgrel=1). One small C file: QEMU is fast enough.
options="!check !archcheck !pmb:crossdirect"
# android-tools-mkbootimg: boot-deploy runs mkbootimg (generate_bootimg)
depends="
	android-tools-mkbootimg
	linux-google-zumapro
	postmarketos-base
"
# linux-headers: <linux/fs.h> for komodo-bootctl (BLK* ioctls); the
# compiler and musl-dev come from build-base, always present in the build
# chroot
makedepends="devicepkg-dev linux-headers"
subpackages="$pkgname-systemd"
source="
	deviceinfo
	kernel-cmdline.conf
	initfs-hook.sh
	60-google-komodo-ufs-ro.rules
	google-komodo-ufs-ro
	google-komodo-initfs.files
	unudhcpd.conf
	google-komodo-modprobe.conf
	komodo-bootctl.c
	komodo-boot-success
	komodo-boot-success.service
	komodo-boot-success.timer
	50-google-komodo-buttons.conf
"

build() {
	devicepkg_build $startdir $pkgname

	# devinfo slot-flag tool (read-only unless --write --i-understand-devinfo)
	${CC:-gcc} $CPPFLAGS $CFLAGS -Wall -Wextra \
		-o "$srcdir"/komodo-bootctl "$srcdir"/komodo-bootctl.c $LDFLAGS
}

package() {
	devicepkg_package $startdir $pkgname

	# UFS read-only guard (rootfs and, through the .files list, initramfs)
	install -Dm644 "$srcdir"/60-google-komodo-ufs-ro.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d/
	install -Dm755 "$srcdir"/google-komodo-ufs-ro \
		-t "$pkgdir"/usr/libexec/
	install -Dm644 "$srcdir"/google-komodo-initfs.files \
		"$pkgdir"/usr/share/mkinitfs/files/10-device-google-komodo.files

	# USB network addresses (initramfs and unudhcpd@usb0)
	install -Dm644 "$srcdir"/unudhcpd.conf "$pkgdir"/etc/unudhcpd.conf

	# Module policy. panthor is no longer blacklisted (tested with the CSF
	# firmware). panel-google-km4 is not listed: it sends nothing until
	# gs_dsim_cmd.allow_tx=1.
	install -Dm644 "$srcdir"/google-komodo-modprobe.conf \
		"$pkgdir"/usr/lib/modprobe.d/google-komodo.conf

	# devinfo: decoding is always available; the write is used only by
	# komodo-boot-success (systemd subpackage, timer NOT enabled by default)
	install -Dm755 "$srcdir"/komodo-bootctl -t "$pkgdir"/usr/bin/
	install -Dm755 "$srcdir"/komodo-boot-success -t "$pkgdir"/usr/libexec/
}

systemd() {
	pkgdesc="$pkgdesc (systemd: login prompt on the USB serial console)"
	install_if="$pkgname=$pkgver-r$pkgrel systemd"

	# serial-getty@ttyGS0: ttyGS0 is the ACM function the initramfs hook
	# adds to the USB gadget. BindsTo=dev-ttyGS0.device in the template.
	mkdir -p "$subpkgdir"/usr/lib/systemd/system/getty.target.wants
	ln -s ../serial-getty@.service \
		"$subpkgdir"/usr/lib/systemd/system/getty.target.wants/serial-getty@ttyGS0.service

	# Slot B boot-success marker. Installed, not enabled (no preset, no
	# .wants link): enabling it means writing one byte of devinfo (0x35,
	# slot B "successful"), which each owner decides; read SLOT-B.md and
	# SAFETY.md in the port's docs/ first. Verified on one unit
	# (2026-11-26, devinfo 3.19): with B marked the retry counter stops
	# dropping, and the ABL no longer falls back to slot A by itself
	# (deduced from the mark; no failed boot has been tried with B marked).
	install -Dm644 "$srcdir"/komodo-boot-success.service \
		"$srcdir"/komodo-boot-success.timer \
		-t "$subpkgdir"/usr/lib/systemd/system/

	# Power key for ui=console: long press powers off (logind)
	install -Dm644 "$srcdir"/50-google-komodo-buttons.conf \
		-t "$subpkgdir"/usr/lib/systemd/logind.conf.d/
}

