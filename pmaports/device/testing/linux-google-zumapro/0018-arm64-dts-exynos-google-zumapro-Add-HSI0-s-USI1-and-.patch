From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Luisyr <106528106+luisyr1@users.noreply.github.com>
Date: Wed, 25 Nov 2026 22:00:00 +0000
Subject: [PATCH 18/20] arm64: dts: exynos: google: zumapro: Add HSI0's USI1
 and its SPI controller

Google's spi_19 (0x111c0000, SPI 407, USI offset 0x1018 in the HSI0
sysreg, from the stock zumapro DTB). On the Pixel 9 Pro XL it carries the
two CS35L41 speaker amplifiers. Disabled by default.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../arm64/boot/dts/exynos/google/zumapro.dtsi | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/zumapro.dtsi b/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
index f6adcff..5e89058 100644
--- a/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
@@ -1066,6 +1066,34 @@
 			status = "disabled";
 		};
 
+		/* Google's spi_19: the speaker amplifiers on the Pixel 9 Pro XL. */
+		usi1_hsi0: usi@111c00c0 {
+			compatible = "google,zumapro-usi", "samsung,exynos850-usi";
+			reg = <0x0 0x111c00c0 0x20>;
+			clocks = <&cmu_hsi0 CLK_GOUT_HSI0_USI1_PCLK>,
+				 <&cmu_hsi0 CLK_GOUT_HSI0_USI1_IP>;
+			clock-names = "pclk", "ipclk";
+			samsung,sysreg = <&sysreg_hsi0 0x1018>;
+			samsung,mode = <USI_MODE_SPI>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges = <0x111c0000 0x0 0x111c0000 0x1000>;
+			status = "disabled";
+
+			spi19: spi@111c0000 {
+				compatible = "google,zumapro-spi", "google,gs101-spi";
+				/* USI control starts at 0xc0; do not claim it twice. */
+				reg = <0x111c0000 0xc0>;
+				interrupts = <GIC_SPI 407 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&cmu_hsi0 CLK_GOUT_HSI0_USI1_PCLK>,
+					 <&cmu_hsi0 CLK_GOUT_HSI0_USI1_IP>;
+				clock-names = "spi", "spi_busclk0";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				status = "disabled";
+			};
+		};
+
 		usi2_hsi0: usi@111d00c0 {
 			compatible = "google,zumapro-usi", "samsung,exynos850-usi";
 			reg = <0x0 0x111d00c0 0x20>;
-- 
