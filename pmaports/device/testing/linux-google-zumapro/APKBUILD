# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: the .config of the RAM-only "display A" build
# (defconfig + omamobile.config + komodo-display.config), plus the options
# pmbootstrap's kconfigcheck.toml asks for (see options=), resolved with
# `make olddefconfig`. See docs/MILESTONE-2.md in this repository.
# This package (patches and config included) is derived from the Linux
# kernel: GPL-2.0-only, as license= says.
maintainer="komodo port <komodo@example.invalid>"
pkgname=linux-google-zumapro
pkgver=7.3_rc6
pkgrel=2
pkgdesc="Google Tensor G4 (zumapro, Pixel 9 Pro XL) close-to-mainline kernel"
arch="aarch64"
_carch="arm64"
_flavor="google-zumapro"
# The repository was renamed on GitHub from linux-omarchy-mobile to
# linux-omamobile; the old URL (used in source= below, as tested) redirects.
url="https://github.com/derekross/linux-omamobile"
license="GPL-2.0-only"
# kconfigcheck: every category of the "community" alias except "hardening"
# (CFI and shadow call stack change code generation; not tried on this
# out-of-tree display/SoC code, and a CFI trap at boot spends a slot B try).
options="!strip !check !tracedeps pmb:cross-native
	pmb:kconfigcheck-accessibility pmb:kconfigcheck-community_various
	pmb:kconfigcheck-containers pmb:kconfigcheck-debug
	pmb:kconfigcheck-filesystems pmb:kconfigcheck-immutable
	pmb:kconfigcheck-input pmb:kconfigcheck-iwd pmb:kconfigcheck-netboot
	pmb:kconfigcheck-netmount pmb:kconfigcheck-nftables pmb:kconfigcheck-usb
	pmb:kconfigcheck-usb_gadgets pmb:kconfigcheck-waydroid
	pmb:kconfigcheck-wine pmb:kconfigcheck-wireguard pmb:kconfigcheck-zram"
makedepends="
	bash
	bc
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	lz4
	openssl-dev
	pahole
	perl
	python3
	zstd
"

# Source: derekross/linux-omamobile (formerly linux-omarchy-mobile), commit
# ffd33b7 (head of PR #276, 2026-11-23). The GitHub tarball unpacks to
# linux-omamobile-<commit> and was checked file by file to be identical to
# the tree tested in Milestone 1. The three display patches ("display A")
# go on top, then the touchscreen (0004), battery (0005-0006), reboot-mode
# (0007, needs reboot=warm from device-google-komodo), KM4 panel brightness
# (0008-0009, inert until gs_dsim_cmd.allow_tx=1), gs-decon hold_boot_fb
# (0010) and the GPU node (0011; panthor autoloads since device-google-komodo
# r3, it needs the CSF firmware from linux-firmware-arm).
_commit="ffd33b7ddc716eb3568fff9f8d337a4032d109eb"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/derekross/linux-omarchy-mobile/archive/$_commit.tar.gz
	$_config
	0001-kernel-configs-komodo-display.config-gs-decon-built-.patch
	0002-arm64-dts-komodo-console-tty0-and-fbcon-font-in-chos.patch
	0003-arm64-dts-komodo-simple-framebuffer-on-ABL-s-buffer-.patch
	0004-arm64-dts-komodo-enable-the-Synaptics-S3908-touchscreen.patch
	0005-arm64-dts-komodo-describe-the-MAX77779-fuel-gauge.patch
	0006-arm64-dts-komodo-describe-the-MAX77779-charger.patch
	0007-arm64-dts-komodo-enable-syscon-reboot-mode.patch
	0008-drm-panel-add-a-minimal-Google-KM4-panel-driver.patch
	0009-arm64-dts-komodo-DSIM0-as-a-DCS-command-host-for-the-KM4.patch
	0010-drm-google-gs-decon-hold-komodo-s-boot-framebuffer-aperture.patch
	0011-arm64-dts-komodo-enable-the-Mali-G715-Panthor.patch
"
builddir="$srcdir/linux-omamobile-$_commit"

prepare() {
	default_prepare
	cp "$srcdir/$_config" .config
	# The config was resolved with Android clang r596125; Alpine's clang
	# may flip toolchain-dependent symbols (CC_HAS_*, ...). Resolve them
	# here, non-interactively, instead of syncconfig prompting mid-build.
	make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
	unset LDFLAGS
	# Generic build identity: no real user/host in "Linux version ..."
	make Image modules dtbs ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-postmarketOS" \
		KBUILD_BUILD_USER=builder KBUILD_BUILD_HOST=komodo
}

package() {
	# Image.lz4 made exactly as Milestone 1 did (lz4 legacy, level 9, no size
	# trailer): the format the ABL is known to boot in boot.img.
	mkdir -p "$pkgdir"/boot
	lz4 -l -9 -c "$builddir/arch/$_carch/boot/Image" > "$pkgdir"/boot/vmlinuz

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -Dm644 "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

