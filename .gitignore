.#*
.DS_Store
Thumbs.db

# ==== Re-includes: legitimate project files (keep at the END) ====
# Only by extension inside the project directories. There is deliberately no
# global "!*.md": it would re-open root files such as getvar-all.md or imei.md.
# A file inside an ignored directory (backups/, tmp/, ...) stays ignored.
!/README.md
!/LICENSE
!/.gitignore
!docs/**/*.md
!scripts/**/*.sh
!scripts/**/*.py
!scripts/**/README.md
!device/**/*.sh
!device/**/README.md

# ==== Re-excludes after the re-includes (keep LAST) ====
# "!docs/**/*.md" must not re-open a dump saved as Markdown inside docs/.
# "!docs/**/*.md" no debe reabrir un volcado guardado como Markdown en docs/.
docs/**/*[iI][mM][eE][iI]*
docs/**/*[gG][eE][tT][vV][aA][rR]*
docs/**/*[gG][eE][tT][pP][rR][oO][pP]*
docs/**/*[dD][mM][eE][sS][gG]*
docs/**/*[sS][eE][rR][iI][aA][lL][nN][oO]*
docs/**/*[hH][aA][sS][hH][eE][sS]*
